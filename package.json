{
  "name": "acessa-workspace-desktop",
  "version": "0.6.49",
  "private": true,
  "description": "Workspace corporativo AcessaNet para Windows",
  "author": "AcessaNet",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "typecheck": "tsc --noEmit",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron && node scripts/audit-build.mjs && node scripts/audit-integration.mjs",
    "audit:integration": "node scripts/audit-integration.mjs",
    "start": "node scripts/start.mjs",
    "dist:win": "npm run build && node scripts/dist-win.mjs",
    "dist:teste": "WORKSPACE_AMBIENTE=teste VITE_AMBIENTE=teste WORKSPACE_UPDATE_URL=https://192.168.1.133:8643/windows/pilot/ npm run dist:win",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/smoke-electron.mjs",
    "dist:win:release": "npm run build && node scripts/dist-win.mjs --release",
    "dev:live": "vite --config vite.live.config.ts --mode live",
    "dev:teste": "VITE_AMBIENTE=teste vite --config vite.teste.config.ts --mode live"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.20.0",
    "builder-util-runtime": "9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.10",
    "emoji-picker-react": "^5.0.0",
    "framer-motion": "^14.2.0",
    "js-yaml": "4.3.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.4",
    "react-router-dom": "^7.18.4",
    "semver": "7.8.5",
    "socket.io-client": "^4.8.4",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.8.0",
    "@types/ssh2": "^1.15.6",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "resedit": "^3.1.0",
    "socket.io": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "productName": "Acessa Workspace"
}
